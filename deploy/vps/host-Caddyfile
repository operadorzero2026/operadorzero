# Bloco para o Caddyfile do servidor. Nao altera os sites ja existentes.
www.operadorzero.com.br {
	redir https://operadorzero.com.br{uri} permanent
}

operadorzero.com.br {
	encode zstd gzip
	# Pedacos de midia do feed (8 MB) tem limite proprio; o resto do site continua em 3 MB.
	@media_upload path /api/media/uploads/*
	request_body @media_upload {
		max_size 9MB
	}
	@other_requests not path /api/media/uploads/*
	request_body @other_requests {
		max_size 3MB
	}
	reverse_proxy 127.0.0.1:8081 {
		header_up X-Real-IP {remote_host}
	}
}
