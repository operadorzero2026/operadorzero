# Copie para deploy/vps/.env no servidor (ignorado pelo Git) e preencha.
# Gere senhas e chave com: openssl rand -base64 48
OZ_HTTP_PORT=8081
DATABASE_PASSWORD=
REDIS_PASSWORD=
AUTH_HASH_KEY=
FRONTEND_BASE_URL=https://operadorzero.com.br
CORS_ALLOWED_ORIGINS=https://operadorzero.com.br,https://www.operadorzero.com.br
MAIL_ENABLED=true
MAIL_FROM=
RESEND_API_KEY=
# Opcionais: Pix das inscricoes pelo Mercado Pago (ver README)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Marketplace (Split 1:1): aplicacao "Operador Zero" no Mercado Pago Developers. Os tokens de cada organizador
# ficam cifrados no banco (nunca aqui). Use as credenciais de TESTE enquanto MERCADOPAGO_ENVIRONMENT=test.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_ENVIRONMENT=test
PLATFORM_DEFAULT_COMMISSION_PERCENT=7
# Login com Google (Google Cloud > Google Auth Platform > Clientes). Redirect autorizado:
# https://operadorzero.com.br/login/oauth2/code/google  e origem: https://operadorzero.com.br
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
